{
  "schemaVersion": 1,
  "id": "sol_client",
  "version": "${version}",
  "name": "Caos",
  "description": "Caos para Fabric 1.21.11 com a nova GUI (Right Shift).",
  "authors": [
    "Caos"
  ],
  "license": "GPL-3.0-only",
  "icon": "assets/sol_client/icon.png",
  "environment": "client",
  "jars": [
    {
      "file": "META-INF/jars/bettersearch-1.6.0.jar"
    }
  ],
  "entrypoints": {
