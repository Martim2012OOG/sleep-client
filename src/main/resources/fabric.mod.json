      "dev.solclient.SolClient"
    ]
  },
  "mixins": [
    "sol_client.mixins.json",
    "sol_client_overlay.mixins.json",
    "sol_client_emote.mixins.json",
    "sol_client_social.mixins.json",
    "sol_client_splash.mixins.json",
    "sol_client_cape.mixins.json",
    "sol_client_cosmetics.mixins.json",
    "sol_client_fightcam.mixins.json",
    "sol_client_extra.mixins.json",
    "sol_client_display.mixins.json",
    "sol_client_font.mixins.json",
    "sol_client_perf.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.3"
