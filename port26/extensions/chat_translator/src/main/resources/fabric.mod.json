{
  "schemaVersion": 1,
  "id": "kubo_ext_chat_translator",
  "version": "${version}",
  "name": "Sleep – Chat Translator",
  "description": "Translates chat from other languages, and lets you write in any language with !en.",
  "authors": [
    "Sleep"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "kubo": [
      "dev.kuboext.chat_translator.ChatTranslatorExtension"
    ]
  },
  "depends": {
    "sol_client": "*",
    "minecraft": ">=26.1 <26.3",
    "fabricloader": ">=0.20.1"
  },
  "custom": {
    "kubo:extension": true
  }
}
